{
  "name": "@klontong/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen:api": "pnpm --dir ../../contracts install --prefer-offline && pnpm --dir ../../contracts run bundle && openapi-typescript ../../contracts/dist/openapi.yaml -o packages/api/src/schema.d.ts",
    "mock": "pnpm --dir ../../contracts run mock",
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
