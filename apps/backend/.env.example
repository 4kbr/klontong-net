# Salin ke .env. Jangan commit .env.

APP_ENV=development
APP_NAME=klontong-api
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=20s
PUBLIC_BASE_URL=http://localhost:8080

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=klontong
DB_PASSWORD=klontong
DB_NAME=klontong
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DATABASE_URL=postgres://klontong:klontong@localhost:5432/klontong?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_DB=0

# Sesi
JWT_SECRET=ganti-dengan-random-32-byte-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=klontong-net

# ---- Payment gateway ----
# Isi salah satu sesuai gateway yang dipakai. Jangan pernah menaruh server key
# di frontend atau di repo.
PAYMENT_PROVIDER=midtrans
PAYMENT_SERVER_KEY=
PAYMENT_CLIENT_KEY=
PAYMENT_IS_PRODUCTION=false
# Rahasia untuk memverifikasi webhook. Gateway menandatangani notifikasinya;
# webhook yang tidak diverifikasi berarti siapa pun bisa menyatakan pesanan lunas.
PAYMENT_WEBHOOK_SECRET=
# Batas waktu pembayaran sebelum pesanan dibatalkan otomatis.
PAYMENT_EXPIRY=24h

# ---- Ongkir ----
# Agregator kurir ekspedisi (Biteship/RajaOngkir/dsb).
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
# Titik asal default marketplace, dipakai kalau outlet belum punya koordinat.
SHIPPING_ORIGIN_LAT=
SHIPPING_ORIGIN_LNG=
# Antar lokal: tarif dasar + tarif per km, dalam rupiah.
LOCAL_DELIVERY_BASE_FARE=8000
LOCAL_DELIVERY_PER_KM=2000
LOCAL_DELIVERY_MAX_KM=15

# ---- Marketplace ----
# Komisi default dalam basis poin. 250 = 2,5%. Basis poin dipakai agar tidak ada
# pecahan yang perlu disimpan. Lihat ADR-005.
COMMISSION_DEFAULT_BPS=250
# Berapa lama dana ditahan setelah pesanan selesai, sebelum bisa dicairkan.
SETTLEMENT_HOLD_PERIOD=72h
# Batas minimum pencairan.
PAYOUT_MINIMUM=50000

# ---- Stok ----
# Berapa lama stok ditahan setelah checkout sebelum reservasi dilepas.
# Harus lebih lama dari PAYMENT_EXPIRY? TIDAK — justru sebaliknya, dan itu
# disengaja. Lihat ADR-003.
STOCK_RESERVATION_TTL=30m

# ---- Object storage ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=klontong
STORAGE_REGION=us-east-1

# ---- Email ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@klontong.test

# ---- Outbox & worker ----
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

LOG_LEVEL=debug
LOG_FORMAT=text
